{
  "name": "wsift",
  "productName": "WSift",
  "version": "0.8.9",
  "description": "WSift — Security Testing Workspace：本地漏洞复测、证据管理与报告交付工作台",
  "main": "electron/main.js",
  "author": "WenYifan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run.js",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "test:e2e": "electron test/e2e-leishen.js --no-sandbox --disable-gpu --ozone-platform=headless --disable-dev-shm-usage",
    "probe": "node test/probe.js"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.wenyifan.wsift",
    "productName": "WSift",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "identity": null
    },
    "dmg": {
      "title": "WSift ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WSift"
    },
    "artifactName": "WSift-${version}-${arch}.${ext}"
  }
}
